    {
        "id": "a7e45f5ced26bd4c",
        "type": "function",
        "z": "e1dcb74d3bfa419c",
        "name": "function 3",
        "func": "let data = msg.payload;\n\n// ป้องกันปัญหาข้อมูลเข้าเป็น String โดยแปลงเป็น Object ทันที\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        data = {};\n    }\n}\n\nlet source = data.source || 'unknown';\nlet imageName = data.image_name ? `'${data.image_name}'` : 'NULL';\nlet classId = Number.isInteger(data.class_id) ? data.class_id : 0;\nlet className = data.class_name || 'unknown';\nlet confidence = typeof data.confidence === 'number' ? data.confidence : 0.0;\n\nlet bboxX = (data.bbox && typeof data.bbox.x === 'number') ? data.bbox.x : 'NULL';\nlet bboxY = (data.bbox && typeof data.bbox.y === 'number') ? data.bbox.y : 'NULL';\n\nmsg.topic = `\nINSERT INTO yolo_predictions (source, image_name, class_id, class_name, confidence, bbox_x, bbox_y)\nVALUES ('${source}', ${imageName}, ${classId}, '${className}', ${confidence}, ${bboxX}, ${bboxY});\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
